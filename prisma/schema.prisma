generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id         String        @id
  name       String
  iconUrl    String?
  queueItems QueueItem[]
  history    PlayHistory[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model QueueItem {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  position  Int
  title     String
  url       String
  duration  String
  thumbnail String?
  author    String
  addedBy   String?
  createdAt DateTime @default(now())

  @@index([guildId, position])
}

model PlayHistory {
  id       String   @id @default(cuid())
  guildId  String
  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title    String
  url      String
  duration String
  author   String
  playedAt DateTime @default(now())

  @@index([guildId, playedAt(sort: Desc)])
}
