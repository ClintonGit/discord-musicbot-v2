# Discord Bot
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here
DISCORD_CLIENT_SECRET=your_client_secret_from_developer_portal

# Web Dashboard
REDIRECT_URI=https://music.commsk.dev/auth/callback
SESSION_SECRET=change_this_to_a_random_string
DASHBOARD_PORT=3000

# Spotify (รับจาก https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/musicbot?client_encoding=UTF8
